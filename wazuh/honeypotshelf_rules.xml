<group name="honeypotshelf,">

  <rule id="107000" level="3">
    <decoded_as>honeypotshelf-audit</decoded_as>
    <description>Honeypot Shelf audit: $(summary)</description>
  </rule>

  <rule id="107001" level="3">
    <decoded_as>honeypotshelf-honeypot-alert</decoded_as>
    <description>Honeypot Shelf: $(label) on honeypot "$(honeypot)"</description>
  </rule>

  <rule id="107002" level="3">
