<decoder name="honeypotshelf">
  <prematch type="pcre2">\bHoneypotShelf\b</prematch>
</decoder>

<decoder name="honeypotshelf-audit">
  <parent>honeypotshelf</parent>
  <prematch type="pcre2">(?=\{"event":"audit")</prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="honeypotshelf-honeypot-alert">
  <parent>honeypotshelf</parent>
  <prematch type="pcre2">(?=\{"event":"honeypot_alert")</prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>
