# Copy this file to `.env` and fill in real values.
# `.env` is NEVER committed (see .gitignore).

# --- Application ---
APP_ENV=development
# A long random string, used for signing (session cookies, CSRF tokens, etc.).
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-generate-a-real-secret

# Host port the web app is published on (container always listens on 8080
# internally). Change this if 8080 is already taken on this host, or you're
# running more than one Honeypot Shelf instance on it.
APP_PORT=8080

# Host network interface the port above is published on. Default 0.0.0.0
# (every interface — reachable from anywhere that can reach this host,
# typically fine behind a firewall or a reverse proxy). Set to 127.0.0.1 to
# only allow local connections (e.g. a reverse proxy running directly on
# this host, not as its own container) without editing docker-compose.yml.
APP_BIND_ADDRESS=0.0.0.0

# Which reverse proxies to trust the X-Forwarded-Proto header from, so the
# app knows a request actually arrived as HTTPS even though the proxy talks
# to it in plain HTTP — without this, WebAuthn/passkeys and OIDC login both
# fail behind any TLS-terminating reverse proxy (bundled Caddy or your
# own), since the app would otherwise think every request is plain HTTP no
# matter what the browser used. "*" (default) trusts any peer — safe even
# from a direct, unproxied client, since a forged header can only make a
# check elsewhere (a WebAuthn origin, an OIDC redirect_uri) fail, never
# spoof it into passing. Narrow this to your proxy's IP/subnet (comma-
# separated, e.g. "172.20.0.0/16,203.0.113.5") if you'd rather not rely on
# that. See app/core/proxy_headers.py.
TRUSTED_PROXY_IPS=*

# Also trust X-Forwarded-For from a TRUSTED_PROXY_IPS peer, to correct
# request.client.host (the audit log's IP column, and the login/TOTP rate
# limiter's per-source bucket key) to the real client behind a reverse
# proxy instead of the proxy's own address — otherwise every request
# behind any proxy shows up as coming from the proxy itself. Off by
# default: unlike TRUSTED_PROXY_IPS above, trusting this from just anyone
# would let an attacker spoof a different "source" on every login/TOTP
# attempt and defeat the rate limiter entirely. Only turn this on once
# you've also narrowed TRUSTED_PROXY_IPS above to your actual proxy's own
# address/subnet (not "*") — see app/core/proxy_headers.py.
TRUST_FORWARDED_FOR=false

# --- Encryption of sensitive data in the DB (LDAP/OIDC secrets, honeypot
# credentials) ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- PostgreSQL ---
# The app builds its connection URL from these — no need to also write out
# DATABASE_URL yourself. Set DATABASE_URL directly instead if you need
# something these can't express (a different host/port, a managed DB).
POSTGRES_USER=honeyhive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=honeyhive
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Web process's own DB connection pool size.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Postgres server tuning (docker-compose.yml's db service) — active from
# the first `docker compose up`, sized for a fleet up to roughly 100
# honeypots while staying RAM-conscious. Raise these for a bigger fleet/
# host, or lower them for a small/constrained one — see
# wiki/Installation.md.
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=128MB
# POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.05
# POSTGRES_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.02

# --- Redis (Celery broker + result backend, and the login rate limiter) ---
# Same as above: the app builds REDIS_URL from REDIS_PASSWORD unless you set
# REDIS_URL directly.
REDIS_PASSWORD=change-me
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# --- SSH management plane (terminal, facts, packages, updates, power —
# ported from debcontrol; a honeypot is managed exactly like a debcontrol
# Machine) ---
# SSH_CONNECT_TIMEOUT, FACTS_REFRESH_INTERVAL_SECONDS,
# REACHABILITY_CHECK_INTERVAL_SECONDS, REACHABILITY_CHECK_CONCURRENCY,
# MONITORING_INTERVAL_SECONDS, UPDATE_TIMEOUT_SECONDS, and
# OPENCANARY_LOG_POLL_INTERVAL_SECONDS used to be configured here — moved to
# Settings → Checks & retention (database-backed, editable without a
# restart). See app/db/models/app_settings.py for current defaults.

# Comma-separated absolute path prefixes the Logs tab's "view a file"/
# "browse" features may read from a managed honeypot (beyond the journal,
# which needs no path). /mnt/tmpfs is where OpenCanary's own log lives
# once a honeypot's been through Initialize — see wiki: Honeypot Initialize.
LOG_FILE_ALLOWED_PATHS=/var/log,/var/lib/docker/containers,/mnt/tmpfs

# Bearer token a not-yet-registered honeypot presents when self-announcing
# via POST /api/inform (see wiki: Honeypot Onboarding). Treat this like a
# password — anyone with it can create pending-honeypot entries.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
INFORM_TOKEN=change-me-generate-a-real-token

# How long (days) raw events are kept before the daily purge job deletes
# them. Default: 180.
EVENT_RETENTION_DAYS=90

# A honeypot with no ingested event for this many seconds shows as
# "offline" on the dashboard/honeypot list. Default: 600 (10 minutes).
HONEYPOT_OFFLINE_AFTER_SECONDS=600

# --- Branding (nav-bar/login logo, browser-tab favicon) ---
# Unset means "use the built-in bee mark" for both. Each may be either a
# URL (http://... or https://...) or a filesystem path readable inside the
# `web` container (mount it in — see docker-compose.yml's commented-out
# `branding` volume) — served at /branding/logo and /branding/favicon
# respectively. See wiki/Installation.md#custom-logo--favicon.
# LOGO_SOURCE=/app/branding/logo.svg
# FAVICON_SOURCE=/app/branding/favicon.png

# --- Logging ---
LOG_LEVEL=INFO

# Deploy-wide starting UI language for an account with no language of its
# own yet (a fresh account, or an anonymous request before any account is
# known) — must match one of app/i18n/locales/*.json's own codes (e.g.
# "en", "cs"); an unrecognized value falls back to English. Anyone can
# still switch for themselves at any time in My account -> Language.
DEFAULT_LANGUAGE=en

# --- Timezone ---
# IANA timezone name (e.g. Europe/Prague), applied to every container (db,
# redis, web, worker, beat, migrate, and caddy if used) and used by the app
# itself to display every timestamp in the UI in local time instead of UTC.
# Defaults to UTC if unset. Data itself is always stored as UTC regardless
# of this.
TZ=UTC

# --- Authentication ---
# Nothing to set here — company/access-level assignment, LDAP, OIDC, and
# TOTP are all configured from inside the app (Users/Settings pages) once
# it's running, not via environment variables. Bootstrap the first
# superadmin account with:
# docker compose exec web python scripts/create_admin.py --username admin
# (see wiki/Installation.md).

# --- Caddy (only used when running with docker-compose.caddy.yml) ---
# Public domain name pointing at this server. Caddy uses it to request a
# trusted certificate from Let's Encrypt automatically.
DOMAIN=honeyhive.example.com
# Email used for Let's Encrypt account/expiry notices.
ACME_EMAIL=admin@example.com

# --- VPN for Honeypot Shelf itself (NetBird or WireGuard, only used with
# docker-compose.vpn.yml) — see wiki/Architecture.md's "VPN connectivity"
# section. The setup key/management URL/WireGuard config are configured
# from Settings -> VPN once the app is running, not here; everything below
# is deploy-time paths that only need changing if you edit
# docker-compose.vpn.yml's volume mounts to something other than its
# defaults.
# NETBIRD_DAEMON_ADDR=unix:///var/run/netbird/sock
# NETBIRD_LOG_PATH=/var/log/netbird/client.log
# NETBIRD_COMMAND_TIMEOUT_SECONDS=30
# VPN_CONTROL_ADDR=/var/run/vpn/control.sock
# VPN_COMMAND_TIMEOUT_SECONDS=30
# WIREGUARD_LOG_PATH=/var/log/vpn/control.log
